{
  "name": "cath-mock-api",
  "version": "1.0.0",
  "private": true,
  "description": "Court and Tribunal Hearings (CaTH) outbound API: a spec-accurate receiver and a simulator that pushes at it.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev -c wrangler.receiver.toml",
    "dev:simulator": "wrangler dev -c wrangler.simulator.toml",
    "deploy": "wrangler deploy -c wrangler.receiver.toml",
    "deploy:simulator": "wrangler deploy -c wrangler.simulator.toml",
    "db:local": "wrangler d1 migrations apply cath-db --local -c wrangler.receiver.toml",
    "db:remote": "wrangler d1 migrations apply cath-db --remote -c wrangler.receiver.toml",
    "test": "npm run test:unit && npm run test:worker",
    "test:unit": "vitest run -c vitest.unit.config.ts",
    "test:worker": "vitest run -c vitest.worker.config.ts",
    "typecheck": "tsc --noEmit",
    "refresh": "powershell -ExecutionPolicy Bypass -File ./scripts/refresh-reference-data.ps1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.9.0",
    "@cloudflare/workers-types": "^5.20260804.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "typescript": "^5.9.2",
    "vitest": "~3.2.0",
    "wrangler": "^4.28.0"
  },
  "overrides": {
    "undici": "7.29.0",
    "sharp": "0.35.2",
    "ws": "8.21.0",
    "@cloudflare/vitest-pool-workers": {
      "wrangler": "4.59.1"
    }
  }
}
